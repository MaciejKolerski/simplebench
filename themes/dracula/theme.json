{
  "version": 1,
  "name": "Dracula",
  "description": "Dracula dark and Alucard light palettes with purple accents and matching terminal colors.",
  "tokens": {
    "--color-background": "#282a36",
    "--color-background-text": "#f8f8f2",
    "--color-surface": "#21222c",
    "--color-surface-text": "#f8f8f2",
    "--color-surface-variant": "#282a36",
    "--color-surface-variant-text": "#f8f8f2",
    "--color-outline": "#6272a4",
    "--color-surface-container": "#282a36",
    "--color-surface-container-high": "#313244",
    "--color-surface-container-highest": "#44475a",
    "--color-primary": "#bd93f9",
    "--color-primary-text": "#282a36",
    "--color-primary-container": "#7c5ac7",
    "--color-secondary": "#ff79c6",
    "--color-surface-tint": "#3d2f43",
    "--color-error": "#ff5555",
    "--color-warning": "#f1fa8c",
    "--color-info": "#8be9fd",
    "--color-accent-text": "var(--color-primary)",
    "--color-muted-text": "color-mix(in srgb, var(--color-outline) 45%, var(--color-surface-text))"
  },
  "terminal": {
    "colors": {
      "background": "var(--color-background)",
      "foreground": "var(--color-surface-text)",
      "cursor": "var(--color-primary)",
      "cursorAccent": "var(--color-background)",
      "selectionBackground": "var(--color-surface-container-highest)",
      "selectionForeground": "var(--color-surface-text)",
      "selectionInactiveBackground": "var(--color-surface-container-high)",
      "black": "var(--color-surface)",
      "red": "var(--color-error)",
      "green": "#50fa7b",
      "yellow": "var(--color-warning)",
      "blue": "var(--color-primary)",
      "magenta": "var(--color-secondary)",
      "cyan": "var(--color-info)",
      "white": "var(--color-surface-text)",
      "brightBlack": "var(--color-outline)",
      "brightRed": "var(--terminal-red)",
      "brightGreen": "var(--terminal-green)",
      "brightYellow": "var(--terminal-yellow)",
      "brightBlue": "var(--terminal-blue)",
      "brightMagenta": "var(--terminal-magenta)",
      "brightCyan": "var(--terminal-cyan)",
      "brightWhite": "var(--color-background-text)",
      "searchMatchBackground": "var(--color-surface-container-highest)",
      "searchActiveMatchBackground": "var(--color-primary-container)",
      "searchMatchBorder": "var(--color-secondary)",
      "searchActiveMatchBorder": "var(--color-primary)"
    }
  },
  "stylesheets": ["theme.css"]
}
