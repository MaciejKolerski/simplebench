{
  "$schema": "./theme.schema.json",
  "version": 1,
  "name": "DeepMono Custom",
  "description": "A starting point with soft corners and a subtle terminal background.",
  "appearance": "dark",
  "tokens": {
    "--radius-control": "8px",
    "--radius-tab": "8px",
    "--radius-pane": "8px",
    "--radius-window": "10px",
    "--terminal-padding": "12px",
    "--settings-page-padding": "28px"
  },
  "backgrounds": {
    "terminal": {
      "image": "images/graphite.svg",
      "size": "cover",
      "position": "center",
      "opacity": 0.25,
      "overlay": "#10101066"
    }
  },
  "terminal": {
    "fontSize": 14,
    "lineHeight": 1.3,
    "cursorStyle": "bar",
    "cursorBlink": true
  },
  "stylesheets": ["theme.css", "styles/components.css"]
}
