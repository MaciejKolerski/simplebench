{
  "$schema": "./theme.schema.json",
  "version": 1,
  "name": "DeepMono Custom",
  "description": "A spacious layout with separate tab rows, soft corners, and a subtle terminal background.",
  "appearance": "dark",
  "tokens": {
    "--radius-control": "8px",
    "--radius-tab": "8px",
    "--radius-pane": "8px",
    "--radius-window": "10px",
    "--terminal-padding": "12px",
    "--settings-page-padding": "28px",
    "--work-area-padding": "8px",
    "--pane-spacing": "4px",
    "--pane-border": "1px solid var(--color-outline)",
    "--radius-sidebar": "8px",
    "--sidebar-section-gap": "4px",
    "--tab-gap": "6px"
  },
  "backgrounds": {
    "terminal": {
      "image": "images/graphite.svg",
      "size": "cover",
      "position": "center",
      "opacity": 0.25,
      "overlay": "#10101066"
    }
  },
  "terminal": {
    "fontSize": 14,
    "lineHeight": 1.3,
    "cursorStyle": "bar",
    "cursorBlink": true
  },
  "stylesheets": ["theme.css", "styles/components.css"],
  "layout": {
    "tabs": "below",
    "statusbar": "bottom",
    "settingsNavigation": "left"
  }
}
