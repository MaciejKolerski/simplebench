{
  "schemaVersion": 1,
  "id": "simplebench.context",
  "name": "Workspace context",
  "version": "1.0.0",
  "description": "A read-only view of the current folder, workspace and appearance.",
  "hostApi": 1,
  "entry": "dist/index.js",
  "activation": "lazy",
  "stylesheets": ["context.css"],
  "contributes": {
    "views": [
      {
        "id": "simplebench.context.view",
        "title": "Workspace context",
        "placement": "central",
        "multiple": false,
        "stateVersion": 1
      }
    ],
    "commands": [
      {
        "id": "simplebench.context.open",
        "label": "Show workspace context",
        "description": "Open the read-only workspace context panel.",
        "context": {
          "workspace": true
        }
      }
    ],
    "keybindings": [
      {
        "command": "simplebench.context.open",
        "shortcut": null
      }
    ],
    "fills": [
      {
        "id": "simplebench.context.status",
        "slot": "statusbar",
        "label": "Workspace context"
      }
    ]
  }
}
